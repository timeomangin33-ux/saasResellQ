legacy-peer-deps=true

# `NODE_ENV=production` est posé dans l'environnement de la machine. Sans cette
# ligne, chaque `npm install` — y compris celui que `vercel build` lance tout
# seul — supprime les dépendances de développement, dont `typescript` et
# `prisma`, et la construction échoue sur « Cannot find module 'typescript' ».
# Le projet a besoin de ces paquets pour se construire : ils ne sont donc pas
# optionnels, quel que soit NODE_ENV.
include=dev
