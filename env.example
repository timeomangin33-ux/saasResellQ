# ================================
# ResellQ - Variables d'environnement
# ================================
# Copier ce fichier en .env.local puis remplir les valeurs rÃ©elles.

# Base de donnÃ©es locale gratuite (SQLite)
DATABASE_URL="file:./resellq.db"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production-with-a-long-random-string"

# OpenAI - IA Agent (optionnel)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4"

# Stripe - Abonnements & Paiements
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""
STRIPE_PRICE_ID_29=""
STRIPE_PRICE_ID_75=""
STRIPE_PRICE_ID_149=""

# Vinted integration relies on encrypted session cookies and Playwright scraping.
# No official Vinted API key is required.
VINTED_COOKIE_SECRET="change-me-with-a-32-plus-character-secret"

# Redis - Job Queue & Caching (pour BullMQ automation)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
# Pour Upstash Redis Cloud:
# REDIS_HOST="redis-xxxxx.upstash.io"
# REDIS_PASSWORD="your_upstash_token"

# Automation Settings
# Set AUTOMATION_ENABLED=false if you do not have an N8N integration.
AUTOMATION_ENABLED="true"
AUTOMATION_SYNC_INTERVAL="14400" # 4 heures en secondes
AUTOMATION_MIN_PROFIT_MARGIN="25" # Marge de profit minimale en %
AUTOMATION_MAX_RISK_LEVEL="medium" # low|medium|high

# Providers optionnels
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
AMAZON_ACCESS_KEY=""
AMAZON_SECRET_KEY=""
AMAZON_REGION=""
EXCHANGERATE_API_KEY=""
RESEND_API_KEY=""
NOVU_API_KEY=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
PINECONE_API_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

