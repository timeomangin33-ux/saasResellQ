    "@react-three/fiber": "^9.6.1",
    "@stripe/stripe-js": "^4.3.0",
    "@tabler/icons-react": "^3.44.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "class-variance-authority": "^0.7.0",
