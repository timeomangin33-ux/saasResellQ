{
  "name": "resellq",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:clean",
    "clean:next": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\"",
    "dev:clean": "npm run clean:next && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "check:spell": "cspell --config .cspell.json \"**/*.{md,ts,tsx,js,jsx,json,html,txt,yml,yaml}\" --no-progress --no-must-find-files",
    "check:ci": "npm run lint && npm run build && npm run check:spell",
    "prisma": "node scripts/prisma.mjs",
    "db:push": "node scripts/prisma.mjs db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx seed.ts",
    "seed:demo": "tsx seed-demo.ts",
    "seed:test": "tsx seed-test-user.ts",
    "clean:prisma-client": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/cleanup-prisma.ps1",
    "rebuild": "npm run clean:prisma-client && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "collector": "tsx scripts/collector.ts",
    "bot:check": "tsx scripts/verifier-robot.ts",
    "sweep": "tsx scripts/balayer.ts",
    "sweep:test": "tsx scripts/tester-balayage.ts",
    "rotation:test": "tsx scripts/tester-verification.ts",
    "rotation:seed": "tsx scripts/amorcer-rotation.ts",
    "collect:once": "tsx scripts/un-tour.ts",
    "history:reset": "tsx scripts/repartir-historique.ts",
    "acces:offrir": "tsx scripts/offrir-acces.ts",
    "targets:seed": "tsx scripts/amorcer-cibles.ts",
    "collect:status": "tsx scripts/etat-collecte.ts",
    "deploy:prod": "npm run collect:pause && vercel pull --yes --environment=production && node scripts/completer-env.mjs && vercel build --prod && vercel deploy --prebuilt --prod && npm run collect:resume",
    "collect:pause": "cmd /c scripts\\pause-collecteur.cmd",
    "collect:resume": "cmd /c scripts\\reprendre-collecteur.cmd"
  },
  "postinstall": "git config core.hooksPath .githooks || true",
  "dependencies": {
    "@auth/prisma-adapter": "^2.4.2",
    "@headlessui/react": "^2.1.2",
    "@hookform/resolvers": "^3.9.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@react-three/fiber": "^9.6.1",
    "@stripe/stripe-js": "^4.3.0",
    "@tabler/icons-react": "^3.44.0",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv-safe": "^9.1.0",
    "framer-motion": "^11.18.2",
    "jspdf-autotable": "^3.8.3",
    "lucide-react": "^0.441.0",
    "motion": "^12.42.0",
    "next": "^15.5.16",
    "next-auth": "^5.0.0-beta.20",
    "openai": "^4.56.0",
    "papaparse": "^5.4.1",
    "playwright": "^1.62.1",
    "prisma": "^5.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "recharts": "^2.12.7",
    "redis": "^6.1.0",
    "resend": "^6.20.0",
    "stripe": "^16.7.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.185.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cspell/dict-fr-fr": "^2.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.5.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.0",
    "autoprefixer": "^10.4.20",
    "cspell": "^10.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.18.0",
    "typescript": "5.8.2",
    "vitest": "^4.1.11"
  }
}
