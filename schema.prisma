generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  emailVerifiedAt    DateTime?
  name               String?
  password           String?
  image              String?
  role               String    @default("USER")
  stripeCustomerId   String?   @unique
  subscriptionId     String?   @unique
  subscriptionStatus String    @default("INACTIVE")
  subscriptionPlan   String    @default("FREE")
  subscriptionEnd    DateTime?
  aiCreditsUsed      Int       @default(0)
  aiCreditsResetAt   DateTime?
  twoFactorEnabled   Boolean   @default(false)
  preferences        Json      @default("{}")
  /// Code du partenaire qui a amené ce compte, figé à l'inscription : il sert
  /// à savoir à qui revient la commission sur chaque facture payée ensuite.
  referralCode       String?
  referredAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts         Account[]
  vintedAccounts   VintedAccount[]
  sessions         Session[]
  conversations    Conversation[]
  watchlists       Watchlist[]
  notifications    Notification[]
  searches         SavedSearch[]
  automationConfig AutomationConfig?
  automationJobs   AutomationJob[]
  alerts           Alert[]
  referral         Referral?         @relation(fields: [referralCode], references: [code], onDelete: SetNull)

  @@index([email])
  @@index([createdAt])
  @@index([referralCode])
  @@map("users")
}

model AIUsageEvent {
  id        String   @id @default(cuid())
  userId    String
  action    String
  credits   Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("ai_usage_events")
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("stripe_webhook_events")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String    @default("New Conversation")
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  name      String
  query     String
  category  String?
  minPrice  Float?
  maxPrice  Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("watchlists")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

// User-configured alert rules (trigger real Notification rows when matched)
model Alert {
  id              String    @id @default(cuid())
  userId          String
  category        String
  condition       String // profit_margin, price_drop, demand_spike
  threshold       Float
  active          Boolean   @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([active])
  @@map("alerts")
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  query     String
  results   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_searches")
}

// Products scraped from Vinted
model Product {
  id              String  @id @default(cuid())
  vintedId        String  @unique
  title           String
  description     String?
  price           Float
  currency        String  @default("EUR")
  category        String
  subcategory     String?
  brand           String?
  size            String?
  condition       String // new, like_new, good, fair, poor
  profitMargin    Float?
  profitPotential Float?
  seller          String?
  /// Identifiant numerique du vendeur, cote Vinted. Le pseudo ne suffit pas :
  /// c'est l'identifiant qui permet d'appeler la penderie du vendeur, et donc
  /// de savoir en une requete si l'annonce est encore en vente.
  sellerId        String?
  location        String?
  imageUrl        String?
  url             String?
  /// active   : revue lors du dernier balayage complet
  /// gone     : absente de deux balayages complets consecutifs (vendue OU retiree)
  /// stale    : plus revue depuis longtemps, sans balayage complet pour trancher
  status          String  @default("active")

  // Signaux de demande, lus sur l'API Vinted. Le prix seul ne dit pas si un
  // article part : c'est le nombre de favoris rapporte au temps passe en ligne
  // qui distingue une bonne affaire d'une annonce qui dort depuis trois mois.
  totalPrice     Float? // prix protection acheteurs incluse
  favouriteCount Int?
  viewCount      Int?
  listedAt       DateTime? // mise en ligne cote Vinted, pas cote base
  lastSeenAt     DateTime? // derniere fois que le robot a revu l'annonce

  /// Nombre de balayages complets consecutifs ou l'annonce etait absente.
  /// Un balayage peut manquer une annonce a cause du decalage de pagination :
  /// on n'en conclut la disparition qu'a partir de deux absences de suite.
  missedSweeps  Int       @default(0)
  /// Horodatage de la disparition constatee. Vendue ou retiree : Vinted ne le
  /// dit pas, et on ne l'invente pas.
  disappearedAt DateTime?
  /// Date a laquelle la page de l'annonce a ete lue pour connaitre son sort.
  /// Une seule fois par annonce, sept jours apres la premiere vue : c'est ce
  /// qui donne une cohorte comparable d'une categorie a l'autre.
  checkedAt     DateTime?
  /// online | closed | hidden | deleted | unknown, lu sur la page de l'annonce.
  finalState    String?

  // AI Scoring
  analysisScore  Float? // 0-100 profitability score
  riskLevel      String? // low, medium, high
  recommendation String? // sell, hold, skip

  // Metadata
  aiProcessed Boolean   @default(false)
  notified    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expiresAt   DateTime? // For data retention

  /// Les index de cette table pesaient 237 Mo pour 243 Mo de donnees, sur une
  /// base plafonnee a 512 Mo — et la collecte s'est arretee sur « could not
  /// extend file because project size limit has been exceeded ». Cinq d'entre
  /// eux ont ete retires apres lecture de pg_stat_user_indexes, qui compte les
  /// lectures reelles :
  ///
  ///   profitMargin   38 Mo pour 3 lectures    - le tri se fait sur analysisScore
  ///   category       20 Mo, redondant         - couvert par [category, status]
  ///   status          6 Mo, redondant         - idem
  ///   subcategory     4,6 Mo pour 4 lectures  - la colonne n'est jamais remplie
  ///   disappearedAt   4,7 Mo pour 2 lectures  - la cohorte se lit par checkedAt
  ///
  /// Un index qui n'est pas lu ne fait pas gagner de temps : il coute de la
  /// place et ralentit chaque ecriture, et cette table est reecrite deux cent
  /// mille fois par jour.
  @@index([brand])
  @@index([analysisScore])
  @@index([createdAt])
  @@index([lastSeenAt])
  @@index([category, status])
  @@index([category, checkedAt])
  @@index([sellerId])
  @@map("products")
}

// Automation Jobs tracking
model AutomationJob {
  id         String    @id @default(cuid())
  userId     String?
  jobType    String // sync, analyze, notify, create-watchlist
  status     String    @default("pending") // pending, running, completed, failed
  input      String? // JSON payload
  result     String? // JSON result
  error      String?
  retries    Int       @default(0)
  maxRetries Int       @default(3)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jobType])
  @@index([status])
  @@index([nextRunAt])
  @@map("automation_jobs")
}

// Category Market Data
/// Un point par catégorie et par jour.
///
/// CategoryMarket ne garde que l'instantané courant : il est écrasé à chaque
/// passage du robot, ce qui rend toute courbe dans le temps impossible. Cette
/// table conserve l'historique, ligne après ligne. C'est elle qui permet de
/// répondre à la seule question qui intéresse un revendeur : est-ce que cette
/// catégorie monte ou descend depuis un mois ?
model CategoryMarketDaily {
  id           String   @id @default(cuid())
  category     String
  day          DateTime @db.Date
  avgPrice     Float?
  medianPrice  Float?
  volumeActive Int?
  sampleSize   Int?
  createdAt    DateTime @default(now())

  @@unique([category, day])
  @@index([category, day])
}

model CategoryMarket {
  id                  String    @id @default(cuid())
  category            String    @unique
  /// Prix demandes sur les annonces recemment mises en ligne, pas sur tout le
  /// stock : Vinted plafonne chaque recherche a 960 resultats et repond
  /// toujours « 960 » a la question du nombre total, donc la mediane du stock
  /// entier n'est calculable par personne. Celle du flux recent l'est
  /// exactement, et c'est de toute facon celle qui interesse un revendeur.
  avgPrice            Float?
  medianPrice         Float?
  /// Premier et troisieme quartile du meme releve. La mediane seule ne dit pas
  /// si une categorie est homogene ou etalee, et c'est cet ecart qui decide
  /// d'un achat : entre p25 et p75 tient la moitie des annonces.
  p25Price            Float?
  p75Price            Float?
  /// Nombre d'annonces recentes derriere ces chiffres.
  priceSample         Int?
  avgMargin           Float?
  volumeSold          Int? // Products sold this week
  volumeActive        Int? // Currently listed
  trendDirection      String? // up, down, stable
  trendStrength       String? // strong, moderate, weak
  priceChangePercent  Float? // % change in avgPrice since the previous refresh
  volumeChangePercent Float? // % change in volumeActive since the previous refresh
  lastAnalyzedAt      DateTime?

  // --- Rotation reelle du stock, mesuree par balayage complet ---
  /// Part des annonces d'une cohorte qui ont disparu dans les 7 jours suivant
  /// leur premiere observation. Disparue = vendue ou retiree : Vinted ne
  /// publie pas les transactions, donc on ne dit jamais "vendue".
  sellThroughRate       Float?
  /// Taille de la cohorte ayant servi au calcul. En dessous d'un seuil, le
  /// taux n'est pas publie.
  sellThroughSample     Int?
  /// Delai median observe entre la premiere vue et la disparition, en jours.
  medianDaysToDisappear Float?
  /// Dernier balayage complet de la categorie.
  lastSweepAt           DateTime?
  /// Part du catalogue reellement parcourue au dernier balayage (0 a 1).
  sweepCoverage         Float?
  /// Nombre de jours d'historique disponibles dans CategoryMarketDaily.
  historyDays           Int?
  /// confirme | en-mesure | insuffisant
  confidence            String?
  /// La categorie est-elle assez fiable pour etre mise en avant ?
  publishable           Boolean   @default(false)
  /// Phrase courte expliquant pourquoi, affichable telle quelle.
  qualityNote           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([publishable])
  @@map("category_markets")
}

// Vinted integration models
model VintedAccount {
  id          String    @id @default(cuid())
  userId      String
  provider    String    @default("vinted")
  displayName String?
  username    String?
  profileUrl  String?
  cookieJar   String? // serialized cookie jar or session token (encrypted in env recommended)
  lastSyncAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  listings VintedListing[]
  sales    VintedSale[]
  syncs    VintedSync[]

  @@index([userId])
}

model VintedListing {
  id        String    @id @default(cuid())
  accountId String
  vintedId  String    @unique
  title     String
  price     Float
  currency  String    @default("EUR")
  category  String?
  brand     String?
  sold      Boolean   @default(false)
  soldAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  account VintedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([vintedId])
}

model VintedSale {
  id        String   @id @default(cuid())
  accountId String
  listingId String?
  price     Float
  currency  String   @default("EUR")
  soldAt    DateTime
  createdAt DateTime @default(now())

  account VintedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model VintedSync {
  id        String   @id @default(cuid())
  accountId String
  syncedAt  DateTime @default(now())
  summary   String? // JSON summary snapshot

  account VintedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

// Automation Settings per User
model AutomationConfig {
  id                  String   @id @default(cuid())
  userId              String   @unique
  enabled             Boolean  @default(true)
  autoCreateWatchlist Boolean  @default(true)
  autoAnalyze         Boolean  @default(true)
  autoNotify          Boolean  @default(true)
  minProfitMargin     Float    @default(25.0)
  maxRiskLevel        String   @default("medium") // low, medium, high
  checkInterval       Int      @default(3600) // seconds
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("automation_configs")
}

/// File de travail du collecteur.
///
/// Le robot tournait sur une liste de douze categories ecrite en dur dans le
/// code du cron, une fois par jour a 6 h. Trois consequences : on ne pouvait
/// rien ajouter sans redeployer, une categorie ratee attendait vingt-quatre
/// heures, et rien ne gardait trace de ce qui avait echoue.
///
/// Cette table renverse le sens : c'est la base qui dit quoi collecter et
/// quand. Le collecteur prend la cible la plus en retard, la traite, replanifie
/// la suivante. Ajouter une recherche, c'est une ligne ; changer une frequence,
/// c'est un UPDATE. Rien a redeployer.
model CollectTarget {
  id              String    @id @default(cuid())
  /// Le texte cherche sur Vinted. Unique : deux lignes identiques feraient
  /// deux fois le meme trafic pour le meme resultat.
  query           String    @unique
  label           String?
  /// Nombre d'annonces visees par passage. 96 = une page Vinted exactement.
  targetItems     Int       @default(96)
  /// Delai souhaite entre deux passages, en minutes.
  intervalMinutes Int       @default(60)
  /// A priorite egale, c'est le plus en retard qui passe en premier.
  priority        Int       @default(0)
  enabled         Boolean   @default(true)
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  /// ok | empty | blocked | auth | network | format | timeout
  lastStatus      String?
  lastError       String?
  lastItemCount   Int?

  /// Delai souhaite entre deux balayages, en minutes.
  /// Un balayage parcourt la categorie tranche de prix par tranche de prix au
  /// lieu de la seule premiere page : c'est lui qui rafraichit lastSeenAt sur
  /// les annonces anciennes et qui rend la disparition detectable.
  sweepIntervalMinutes Int       @default(720)
  /// Budget de pages pour un balayage entier. 96 annonces par page cote Vinted,
  /// et 960 annonces au maximum par tranche de prix : c'est Vinted qui plafonne.
  ///
  /// Ramene de 70 a 30. Le balayage profond avait ete dimensionne pour conclure
  /// les disparitions par absence du catalogue ; cette methode a ete abandonnee
  /// au profit de la lecture de la penderie du vendeur, qui ne depend pas de la
  /// profondeur. Les soixante pages supplementaires ne servaient donc plus qu'a
  /// grossir le stock d'annonces - jusqu'a saturer les 512 Mo de la base et
  /// arreter toute ecriture. Trente pages couvrent toujours les dix tranches de
  /// prix, donc l'echantillon reste reparti sur toute l'echelle.
  sweepMaxPages        Int       @default(30)
  /// Tranche de prix par laquelle commencer le prochain balayage. Fait tourner
  /// le point d'entree : sans lui, un budget trop court voudrait dire que les
  /// tranches hautes ne sont jamais lues, donc que les articles chers - ceux
  /// qui rapportent - seraient les seuls dont on ne sait rien.
  sweepCursor          Int       @default(0)
  lastSweepAt          DateTime?
  lastSweepPages       Int?
  /// Nombre de tranches de prix vues en entier au dernier balayage.
  lastSweepZones       Int?
  /// Vrai quand toutes les tranches parcourues l'ont ete en entier.
  lastSweepComplete    Boolean   @default(false)
  /// Sert au recul automatique : une cible qui echoue est repoussee de plus en
  /// plus loin, au lieu de consommer le budget des cibles qui fonctionnent.
  consecutiveFailures  Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([enabled, nextRunAt])
  @@index([priority])
  @@map("collect_targets")
}

/// Un partenaire (influenceur, apporteur d'affaires) et son code de parrainage.
/// `beneficiaire` est le nom humain de la personne à payer : le code seul ne
/// suffit pas à savoir à qui envoyer le virement, des mois plus tard.
model Referral {
  id            String   @id @default(cuid())
  /// Ce qui est écrit dans ?ref=... — toujours en majuscules pour qu'un lien
  /// recopié en minuscules par un partenaire attribue quand même la vente.
  code          String   @unique
  beneficiaire  String
  email         String?
  commissionPct Float    @default(30)
  actif         Boolean  @default(true)
  notes         String?
  /// Ce qui ouvre la page /partenaire : le partenaire n'a pas de compte sur
  /// ResellQ, et lui en créer un l'obligerait à un mot de passe pour consulter
  /// un tableau qui ne le concerne que lui. Le jeton tient ce rôle.
  ///
  /// Produit par Postgres et non par Prisma : la colonne s'ajoute à une table
  /// qui a déjà des lignes, et un `cuid()` côté client ne remplit que les
  /// lignes créées ensuite — les partenaires existants seraient restés sans
  /// jeton, donc sans page.
  jeton         String   @unique @default(dbgenerated("gen_random_uuid()::text"))
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  filleuls    User[]
  commissions ReferralCommission[]
  visites     ReferralVisite[]

  @@index([actif])
  @@map("referrals")
}

/// Une ligne par facture Stripe réellement encaissée pour un filleul.
///
/// Cette table n'est qu'un registre de dettes : ResellQ n'envoie jamais
/// d'argent. `statut` passe à "paye" quand l'exploitant a fait le virement de
/// sa main et vient le déclarer ici.
model ReferralCommission {
  id              String    @id @default(cuid())
  referralId      String
  /// Nullable : le compte du filleul peut être supprimé après coup, la dette
  /// envers le partenaire reste due.
  userId          String?
  /// Unique : une même facture ne doit jamais engendrer deux commissions, y
  /// compris quand Stripe rejoue son webhook.
  stripeInvoiceId String    @unique
  /// En centimes, ce que Stripe a réellement collecté (`amount_paid`), remises
  /// déduites — pas le prix affiché du forfait.
  montantEncaisse Int
  devise          String    @default("eur")
  /// Recopié depuis Referral au moment du calcul : changer le taux d'un
  /// partenaire plus tard ne doit pas réécrire ce qui lui était dû avant.
  commissionPct   Float
  /// En centimes.
  montantDu       Int
  /// "du" | "paye" | "annule"
  statut          String    @default("du")
  payeLe          DateTime?
  createdAt       DateTime  @default(now())

  // Restrict et pas Cascade : supprimer un partenaire effacerait l'historique
  // de ce qui lui a été dû et versé. La base refuse donc la suppression tant
  // que des commissions existent.
  referral Referral @relation(fields: [referralId], references: [id], onDelete: Restrict)

  @@index([referralId, statut])
  @@map("referral_commissions")
}

/// Combien de personnes un lien de parrainage a amenées, par code et par jour.
///
/// Sans cette table, un partenariat est aveugle jusqu'à la première facture :
/// un lien recopié de travers, un code désactivé ou une campagne que personne
/// ne regarde produisent tous le même écran — zéro — et rien ne les distingue.
/// Le compteur sépare « personne ne clique » de « on clique et personne ne
/// s'inscrit », qui n'appellent pas la même correction.
///
/// Agrégé par jour plutôt qu'une ligne par visite : ce registre doit pouvoir
/// tourner des années sans surveillance, et personne n'a besoin de savoir à
/// quelle seconde un visiteur est passé. Aucune adresse IP, aucun identifiant
/// de navigateur n'y est écrit — il n'y a rien ici qui désigne quelqu'un.
model ReferralVisite {
  code      String
  /// Minuit UTC du jour concerné. Normalisé à l'écriture : deux visites du
  /// même jour doivent tomber sur la même ligne, quel que soit le fuseau de
  /// la machine qui les enregistre.
  jour      DateTime
  visiteurs Int      @default(0)

  // Cascade, contrairement aux commissions : un compteur de visites n'est pas
  // de l'argent dû. Supprimer un partenaire peut effacer ses visites, jamais
  // l'historique de ce qui lui était dû.
  referral Referral @relation(fields: [code], references: [code], onDelete: Cascade)

  @@id([code, jour])
  @@map("referral_visites")
}
